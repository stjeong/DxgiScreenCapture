<?xml version="1.0"?>
<package xmlns="http://schemas.microsoft.com/packaging/2011/10/nuspec.xsd">
    <metadata>
        <id>DxgiScreenCapture</id>
        <title>Screeen Capture Library using SharpDX</title>
        <version>1.0.5</version>
        <authors>SeongTae Jeong</authors>
        <requireLicenseAcceptance>false</requireLicenseAcceptance>
        <description>Screeen Capture Library using SharpDX</description>
        <readme>docs\README.md</readme>
        <tags>Screen Capture DXGI SharpDX</tags>
        <projectUrl>https://github.com/stjeong/DxgiScreenCapture</projectUrl>
        <license type="expression">MIT</license>
        <dependencies>
            <group targetFramework=".NETFramework4.0" />
            <group targetFramework="net8.0" />
        </dependencies>
    </metadata>
    <files>
        <file src="README.md" target="docs\" />
        <file src="lib\net8.0\*.dll" target="lib\net8.0" />
        <file src="lib\net8.0\*.pdb" target="lib\net8.0" />
        
        <file src="lib\net40\*.dll" target="lib\net40" />
        <file src="lib\net40\*.pdb" target="lib\net40" />
    </files>
</package>